# QueryMind settings template
# 1. Copy this file and name the copy ".env"   (Windows: copy .env.example .env   |   macOS/Linux: cp .env.example .env)
# 2. Put your own API key in .env
# 3. Run: streamlit run app.py
# Never commit .env: it holds your private key and is already listed in .gitignore. This example file is safe to share.

# ------------------------------------------------------------------ Language model (required)
LLM_PROVIDER=groq                       # groq | openai | ollama | custom
GROQ_API_KEY=your_groq_api_key_here     # free key: https://console.groq.com/keys
LLM_MODEL=openai/gpt-oss-120b           # or openai/gpt-oss-20b for faster answers
LLM_REASONING_EFFORT=medium             # low | medium | high

# Using OpenAI instead?  Set LLM_PROVIDER=openai and fill in:
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4.1-mini

# Using a local model with Ollama (no key needed)?  Set LLM_PROVIDER=ollama and:
# LLM_MODEL=gpt-oss:20b

# Any other OpenAI-compatible service?  Set LLM_PROVIDER=custom and:
# LLM_BASE_URL=https://your-provider.example.com/v1
# LLM_API_KEY=your_api_key_here

# ------------------------------------------------------------------ Database (optional)
# By default the app opens a real public dataset and downloads it on first use:
# chinook | northwind | sakila | titanic | covid_latest | tips
DEFAULT_DATASET=chinook

# Or connect straight to your own database (this takes priority over DEFAULT_DATASET):
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/your_database
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/your_database
# DATABASE_URL=sqlite:///C:/path/to/your.db

# ------------------------------------------------------------------ Behaviour (optional, defaults shown)
READ_ONLY=true                          # false allows data changes (each one still needs a confirm click)
ROW_LIMIT=500                           # max rows returned per query
MAX_SQL_RETRIES=3                       # self-correction attempts when a query fails
MAX_REASONING_STEPS=5                   # step budget for multi-hop questions
HISTORY_TURNS=8                         # recent exchanges kept in full; older ones are summarised
QUERY_TIMEOUT_S=30
LLM_TEMPERATURE=0.1
